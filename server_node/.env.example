# Environment Configuration for Render / Production
NODE_ENV=production
PORT=10000
INSTANCE_NAME=Render-Server
APP_URL=https://<your-render-service-name>.onrender.com/
CLIENT_URL=https://your-custom-frontend-url.com
MONGOURL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<host>:<port>
JWT_SECRET=super_secret_jwt_key_here
